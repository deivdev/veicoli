# Security - genera con: openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Admin user creato al primo avvio
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Abilita la registrazione pubblica (senza invito).
# A false si entra solo tramite link di invito di una famiglia: un invito
# valido funziona comunque, anche con questo flag disattivato.
REGISTRATION_ENABLED=false

# URL pubblico del backend (visto dal browser)
# In locale: http://localhost:8000
# Su Synology dietro reverse proxy: https://veicoli.tuo-dominio.it/api
PUBLIC_API_URL=http://localhost:8000
